# Copy to .env and fill in. `id -u` / `id -g` so files written in /work and /out are yours.
UID=1000
GID=1000

# Use a Console workspace key with a spend limit set on the workspace.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_CODE_VERSION=latest

# Host paths
DATA_DIR=/srv/librivox/data          # audio, librivox index.html, gutenberg html, ASR outputs
WORK_DIR=.                           # this repo
OUT_DIR=/srv/librivox/out            # generated manifests, logs, review tables
SRC_PROJECTS_DIR=/srv/librivox/src   # librivox-matching/, librivox-multispeaker/, kaldi aligner

# GPUs (indices as seen by nvidia-smi). Worker and LLM on different cards if you can.
WORKER_GPUS=0
LLM_GPUS=1
LLM_MODEL=Qwen/Qwen3-8B
LLM_GPU_UTIL=0.85
LLM_MAX_LEN=32768
VLLM_IMAGE=vllm/vllm-openai:latest

HF_TOKEN=
